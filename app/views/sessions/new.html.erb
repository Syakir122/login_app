<div class="login-container">
  <h1>Login Page</h1>

  <!-- Flash Messages -->
  <% if flash[:error] %>
    <p class="error-message"><%= flash[:error] %></p>
  <% end %>

  <% if flash[:notice] %>
    <p class="success-message"><%= flash[:notice] %></p>
  <% end %>

  <!-- Login Form -->
  <%= form_tag login_path, method: :post do %>
    <div class="form-group">
      <%= label_tag :username, "Username" %>
      <%= text_field_tag :username, params[:username], class: "form-control", placeholder: "Enter username" %>
    </div>

    <div class="form-group">
      <%= label_tag :password, "Password" %>
      <%= password_field_tag :password, nil, class: "form-control", placeholder: "Enter password" %>
    </div>

    <div class="form-actions">
      <%= submit_tag "Login", class: "btn-submit" %>
    </div>
  <% end %>

  <!-- Optional Logout Button if logged in -->
  <% if session[:user_id] %>
    <div class="logout-section">
      <p>Logged in as: <strong><%= session[:user_id] %></strong></p>
      <%= button_to "Logout", logout_path, method: :delete, class: "btn-logout" %>
    </div>
  <% end %>
</div>